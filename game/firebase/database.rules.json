{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "newData.hasChildren(['host', 'created', 'status', 'startAt', 'difficulty', 'seed'])",
        "host": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "created": { ".validate": "newData.isNumber()" },
        "seed": { ".validate": "newData.isNumber()" },
        "status": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|starting|playing)$/)"
        },
        "startAt": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "difficulty": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(normal|hard)$/)"
        },
        "slots": {
          "$slot": {
            ".write": "auth != null && root.child('rooms').child($code).child('host').exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "$slot.matches(/^s[0-2]$/) && newData.isString()"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('host').exists()",
            ".validate": "newData.hasChildren(['name', 'ready', 'slot'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "ready": { ".validate": "newData.isBoolean()" },
            "slot": {
              ".validate": "(newData.val() === 0 && newData.parent().parent().parent().child('slots/s0').val() === $uid) || (newData.val() === 1 && newData.parent().parent().parent().child('slots/s1').val() === $uid) || (newData.val() === 2 && newData.parent().parent().parent().child('slots/s2').val() === $uid)"
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
